[Unit]
Description=Fetch AWSCURRENT secret and restart demo services
Wants=network-online.target
After=network-online.target
# Retry a few times at boot (IAM credentials / network can take a moment), then give up.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=/root/refresh_secrets.sh
Restart=on-failure
RestartSec=20

[Install]
# Enabled => runs on EVERY boot, so an instance stopped during a rotation
# converges to AWSCURRENT as soon as it starts again.
WantedBy=multi-user.target
